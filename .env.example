# Discord OAuth app (Discord Developer Portal -> your app -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Same bot token your Discord bot uses (needed to check guild roles server-side)
DISCORD_BOT_TOKEN=

# Your Pixel Villa guild/server ID
DISCORD_GUILD_ID=1510176142286389329

# Comma-separated role IDs allowed into the dashboard (Moderator, Senior Mod, Head Mod, Admin)
STAFF_ROLE_IDS=1511051007772069929

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_-base64_32

# Firebase — same project the bot already uses.
# Paste the full service account JSON as ONE line (see README for how).
FIREBASE_KEY=
